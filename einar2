#!/bin/bash

san_cmd_run() {

  local cmd="$1"
  local lab="$2"

  if [[ -z "$cmd" ]] ; then
    ./libexec/e2-help.sh run
    exit
  elif [[ -z "$lab" && "$cmd" != "ls" && "$cmd" != "ln" ]] ; then
    echo "usage: run start <lab>"
    exit
  else
    ./libexec/e2-run.sh "$cmd" "$lab"
  fi

}

san_cmd_edit() {

  local cmd="$1"
  local lab="$2"

  if [[ -z "$cmd" ]] ; then
    ./libexec/e2-help.sh edit
    exit
  elif [[ -z "$EDITOR" ]] ; then
    echo '$EDITOR is unset'
    exit
  elif [[ -z "$lab" || ! -d "$lab" ]] ; then
    echo "error: invalid directory"
    echo "usage: edit <section> <lab>"
    exit
  else
    ./libexec/e2-edit.sh "$cmd" "$lab"
  fi

}

san_cmd_gen() {

  local what="$1"

  if [[ -z "$what" ]] ; then
    ./libexec/e2-help.sh gen
    exit
  else
    ./libexec/e2-gen.sh "${@}"
  fi

}

cmd="$1"

if [[ -z "$cmd" ]] ; then
  ./libexec/e2-help.sh help
  exit

elif [[ "$cmd" == "run" ]] ; then
  shift
  san_cmd_run "${@}"

elif [[ "$cmd" == "edit" ]] ; then
  shift
  san_cmd_edit "${@}"

elif [[ "$cmd" == "gen" ]] ; then
  shift
  san_cmd_gen "${@}"

else
  echo "Unknown command: $cmd"
fi
