#!/bin/sh

if [ "$#" -eq 1 ]; then
    old_ifs="$IFS"
    IFS=' '
    set -- $1
    IFS="$old_ifs"
fi

mode="halt-on-error"

while [ "$#" -gt 0 ]; do
    case "$1" in
        --oneshot)
            mode="oneshot"
            shift
            ;;
        --simple)
            mode="simple"
            shift
            ;;
        --forking)
            mode="forking"
            shift
            ;;
        --halt-on-error)
            mode="halt-on-error"
            shift
            ;;
        -*)
            echo "eterm: unknown option: $1" >&2
            echo "usage: eterm [--oneshot|--simple|--forking|--halt-on-error] <cmd> [arg...]" >&2
            exit 1
            ;;
        *)
            break
            ;;
    esac
done

if [ "$#" -eq 0 ]; then
    echo "usage: eterm [--oneshot|--simple|--forking|--halt-on-error] <cmd> [arg...]"
    exit 1
fi

pre_cmd="$*"
case "$mode" in
    oneshot)
        cmd="$pre_cmd"
        ;;
    simple)
        cmd="$pre_cmd; printf '\n[Process completed]\n'; printf 'Press Enter to close terminal...'; read ANS"
        ;;
    forking)
        cmd="$pre_cmd; bash -l"
        ;;
    halt-on-error)
        cmd="$pre_cmd || { printf '\n[Process halted]\n'; printf 'Press Enter to close terminal...'; read ANS; }"
        ;;
esac

lxterminal -e "$cmd" &
