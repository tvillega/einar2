#!/bin/bash

PKG_BBIN_DIR=$( cd "$(dirname "${BASH_SOURCE[0]}")" ; pwd -P )
PKG_ROOT_DIR=$( cd "$PKG_BBIN_DIR/.." ; pwd -P )

PKG_LIBX_DIR="$PKG_ROOT_DIR/libexec"
PKG_ETC_DIR="$PKG_ROOT_DIR/etc"

export PKG_ROOT_DIR
export PKG_LIBX_DIR
export PKG_SHARE_DIR
export PKG_ETC_DIR

# default settings
source "${PKG_ROOT_DIR}/defaults.conf"

# default settings overrides
[[ -f ~/.einar.conf ]] && source ~/.einar.conf
[[ -f /etc/einar.conf ]] && source /etc/einar.conf
[[ -f /usr/local/etc/einar.conf ]] && source /usr/local/etc/einar.conf

export DOCKER_IMAGE

cmd_run() {

  local what="$1"

  if [[ -z "$what" ]] ; then
    $PKG_LIBX_DIR/e2-help.sh run
    exit
  else
    $PKG_LIBX_DIR/e2-hook.sh run -1 "${@}"
    $PKG_LIBX_DIR/e2-run.sh "${@}"
    $PKG_LIBX_DIR/e2-hook.sh run  1 "${@}"
  fi

}

cmd_edit() {

  local what="$1"

  [[ -z "$EDITOR" ]] && echo "EDITOR unset" && exit

  if [[ -z "$what" ]] ; then
    $PKG_LIBX_DIR/e2-help.sh edit
    exit
  else
    $PKG_LIBX_DIR/e2-hook.sh edit -1 "${@}"
    $PKG_LIBX_DIR/e2-edit.sh "${@}"
    $PKG_LIBX_DIR/e2-hook.sh edit  1 "${@}"
  fi

}

cmd_gen() {

  local what="$1"

  if [[ -z "$what" ]] ; then
    $PKG_LIBX_DIR/e2-help.sh gen
    exit
  else
    $PKG_LIBX_DIR/e2-hook.sh gen -1 "${@}"
    $PKG_LIBX_DIR/e2-gen.sh "${@}"
    $PKG_LIBX_DIR/e2-hook.sh gen  1 "${@}"
  fi

}

cmd="$1"

if [[ -z "$cmd" ]] ; then
  $PKG_LIBX_DIR/e2-help.sh help
  exit

elif [[ "$cmd" == "run" || "$cmd" == "r" ]] ; then
  shift
  cmd_run "${@}"

elif [[ "$cmd" == "edit" || "$cmd" == "e" ]] ; then
  shift
  cmd_edit "${@}"

elif [[ "$cmd" == "gen" || "$cmd" == "g" ]] ; then
  shift
  cmd_gen "${@}"

else
  echo "Unknown command: $cmd"
fi
