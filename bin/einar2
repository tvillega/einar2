#!/bin/sh

set -eu
IFS='
	'

PKG_BIN_DIR=$( cd "$(dirname "$0")" ; pwd -P )
PKG_ROOT_DIR=$( cd "$PKG_BIN_DIR/.." ; pwd -P )

PKG_LIB_DIR="${PKG_ROOT_DIR}/libexec"
PKG_SHARE_DIR="${PKG_ROOT_DIR}/share"
PKG_ETC_DIR="${PKG_ROOT_DIR}/config"

export PKG_ROOT_DIR
export PKG_BIN_DIR
export PKG_LIB_DIR
export PKG_SHARE_DIR
export PKG_ETC_DIR

PKG_ARCH_DIR=$( cd "${PKG_SHARE_DIR}/archetypes" ; pwd -P )
PKG_HOOK_DIR=$( cd "${PKG_SHARE_DIR}/hooks" ; pwd -P )

export PKG_ARCH_DIR
export PKG_HOOK_DIR

# settings overrides
[ -f /etc/einar2/einar2.conf ] && . /etc/einar2/einar2.conf
[ -f /usr/local/etc/einar2/einar2.conf ] && . /usr/local/etc/einar2/einar2.conf
[ -f ~/.einar2.conf ] && . ~/.einar2.conf

XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
[ -f "$XDG_CONFIG_HOME/einar2/einar2.conf" ] && . "$XDG_CONFIG_HOME/einar2/einar2.conf"

export LOCAL UPSTREAM
export UTILS_TARBALL IMAGE_TARBALL
export UPSTREAM_UTILS_URL UPSTREAM_IMAGE_URL

export LABS_ROOT

cmd_init() {
  if [ "$#" -eq 0 ] ; then
    "$PKG_LIB_DIR/einar2-help.sh" init
    exit
  else
    "$PKG_LIB_DIR/einar2-hook.sh" init -1 "${@}"
    "$PKG_LIB_DIR/einar2-init.sh" "${@}"
    "$PKG_LIB_DIR/einar2-hook.sh" init  1 "${@}"
  fi
}

cmd_labs() {
  if [ "$#" -eq 0 ] ; then
   "$PKG_LIB_DIR/einar2-help.sh" labs
    exit
  else
    "$PKG_LIB_DIR/einar2-hook.sh" labs -1 "${@}"
    "$PKG_LIB_DIR/einar2-labs.sh" "${@}"
    "$PKG_LIB_DIR/einar2-hook.sh" labs  1 "${@}"
  fi
}

cmd_netns() {
  if [ "$#" -eq 0 ] ; then
    "$PKG_LIB_DIR/einar2-help.sh" netns
    exit
  else
    "$PKG_LIB_DIR/einar2-hook.sh" netns -1 "${@}"
    "$PKG_LIB_DIR/einar2-netns.sh" "${@}"
    "$PKG_LIB_DIR/einar2-hook.sh" netns  1 "${@}"
  fi
}


cmd="$1"

if [ -z "$cmd" ] ; then
  "$PKG_LIB_DIR/einar2-help.sh" help
  exit

elif [ "$cmd" = "selfupdate" ] ; then
  shift
  cmd_init selfupdate

elif [ "$cmd" = "labs" ] ; then
  shift
  cmd_labs "${@}"

elif [ "$cmd" = "netns" ] ; then
  shift
  cmd_netns "${@}"

else
  echo "$(basename "$0"): unknown command: $cmd" >&2
fi
