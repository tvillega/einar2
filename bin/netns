#!/bin/sh

# Find docker netns list /run/docker/netns
# and append it to system netns list /run/netns

cmd_attach() {
    echo "-> ip net list"
    ip net list

    echo ":: Attaching einar2 docker containers"

    for c in $(docker ps --format '{{.Names}}'); do
        case "$c" in
            e2-*)
                P=$(docker inspect --format '{{ .State.Pid }}' "$c" 2>/dev/null)
                if [ -n "$P" ] && [ "$P" != "0" ]; then
                    echo "$c -> $P"
                    ip netns attach "$c" "$P"
                else
                    echo "Warning: Could not get valid PID for $c" >&2
                fi
                ;;
        esac
    done

    echo "-> ip net list"
    ip net list
}

# Find docker netns under /run/nets
# and delete them from the system

cmd_detach() {
    echo "-> ip net list"
    ip net list

    echo ":: Detaching einar2 docker containers"

    for c in $(docker ps --format '{{.Names}}'); do
        case "$c" in
            e2-*)
                echo "Detaching $c"
                ip netns delete "$c" 2>/dev/null || true
                ;;
        esac
    done

    echo "-> ip net list"
    ip net list
}

cmd="$1"

if [ -z "$cmd" ]; then
    exit 0
elif [ "$cmd" = "attach" ] ; then
    shift
    cmd_attach "$@"
elif [ "$cmd" = "detach" ] ; then
    shift
    cmd_detach "$@"
else
    echo "Unknown command: $cmd" >&2
    exit 1
fi
