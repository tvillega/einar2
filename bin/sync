#!/bin/bash

PKG_BBIN_DIR=$( cd "$(dirname "${BASH_SOURCE[0]}")" ; pwd -P )
PKG_ROOT_DIR=$( cd "${PKG_BBIN_DIR}/.." ; pwd -P )

PKG_SHARE_DIR="${PKG_ROOT_DIR}/share"
PKG_LIBX_DIR="${PKG_ROOT_DIR}/libexec"

export PKG_ROOT_DIR

PKG_DOCS_DIR="${PKG_ROOT_DIR}/docs"
PKG_WWW_DIR="${PKG_ROOT_DIR}/www"

fun_sync_archetypes() {

  local s="$1" ; shift
  local archdir="${PKG_WWW_DIR}/archetypes"

  if [[ $s -lt 0 ]] ; then
    rm -rfv "$archdir"
  else
    if [[ ! -d "$archdir" ]] ; then
      mkdir -v "$archdir"
    fi
    cp -rv --remove-destination "$PKG_SHARE_DIR"/archetypes/*  "${archdir}/"
  fi

}

fun_sync_docs_advguide() {

  local s="$1" ; shift
  local advguidedir="${PKG_WWW_DIR}/docs/advguide"

  if [[ $s -lt 0 ]] ; then
    rm -rfv $advguidedir
  else
    if [[ ! -d "$advguidedir" ]] ; then
      mkdir -v "$advguidedir"
    fi
    cp -rv --remove-destination "$PKG_DOCS_DIR"/advguide/* "${advguidedir}/"
  fi

}

fun_sync_docs_userguide() {

  local s="$1" ; shift
  local guidedir="${PKG_WWW_DIR}/docs/userguide"

  if [[ $s -lt 0 ]] ; then
    rm -rfv $guidedir
  else
    if [[ ! -d "$guidedir" ]] ; then
      mkdir -v "$guidedir"
    fi
    cp -rv --remove-destination "$PKG_DOCS_DIR"/userguide/* "${guidedir}/"
  fi

}

fun_sync_docs_changelog() {

  local s="$1" ; shift

  if [[ $s -lt 0 ]] ; then
    rm -v "$PKG_WWW_DIR"/docs/index.md
    rm -v "$PKG_WWW_DIR"/docs/releasenotes.md
  else
    cp -rv --remove-destination "$PKG_DOCS_DIR"/index.md     "$PKG_WWW_DIR"/docs/index.md
    cp -v  --remove-destination "$PKG_ROOT_DIR"/CHANGELOG.md "$PKG_WWW_DIR"/docs/releasenotes.md
    fun_sync_docs_userguide $s
    fun_sync_docs_advguide  $s
  fi

}

fun_sync_docs() {

  local s="$1" ; shift

  if [[ $s -lt 0 ]] ; then
    rm -v "$PKG_WWW_DIR"/docs/index.md
    rm -v "$PKG_WWW_DIR"/docs/releasenotes.md
  else
    cp -rv --remove-destination "$PKG_DOCS_DIR"/index.md     "$PKG_WWW_DIR"/docs/index.md
    cp -v  --remove-destination "$PKG_ROOT_DIR"/CHANGELOG.md "$PKG_WWW_DIR"/docs/releasenotes.md
    fun_sync_docs_userguide $s
    fun_sync_docs_advguide  $s
  fi

}

fun_sync_settings() {

  local s="$1" ; shift

  if [[ $s -lt 0 ]] ; then
    rm -v "$PKG_WWW_DIR"/settings.json
  else
    cp -v  --remove-destination "$PKG_SHARE_DIR"/webui/defaults.json "$PKG_WWW_DIR"/settings.json
  fi

}

fun_sync_all() {

  local s="$1" ; shift

  fun_sync_archetypes $s
  fun_sync_docs       $s
  fun_sync_settings   $s

}

cmd="$1"

if [[ -z "$cmd" ]] ; then
  $PKG_LIBX_DIR/e2-help.sh sync
  exit

elif [[ "$cmd" == "yay" || "$cmd" == "y" ]] ; then
  shift
  fun_sync_all  1

elif [[ "$cmd" == "nay" || "$cmd" == "n" ]] ; then
  shift
  fun_sync_all  -1

else
  echo "Unknown command: $cmd"
fi
