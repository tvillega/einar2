#!/bin/sh

set -eu
IFS='
	'

launch() {
    nohup "$@" >> /dev/null 2>&1 &
    disown "$!" 2>/dev/null || true
}

log() {
    lv="${2:-I}"
    ts=$(date "+%Y/%m/%d %H:%M:%S")
    printf "%s ework[%d] %s %s\n" "$ts" "$$" "$lv" "$1" >&2
}

reply() {
    printf -- "%s" "$1"
}

parser_launch() {
    case "$1" in
        lxterminal)
            log "lxterminal: launching on display"
            launch lxterminal
            reply "DONE"
            ;;
        wireshark)
            log "wireshark: launching on display"
            launch wireshark
            reply "DONE"
            ;;
        featherpad)
            log "featherpad: launching on display"
            launch featherpad
            reply "DONE"
            ;;
        webui)
            log "webui: launching on display"
            launch firefox "http://localhost:80"
            reply "DONE"
            ;;
        *)
            log "$1: not recognized as an einar worker launchable" "E"
            reply "FAILED"
            ;;
    esac
}

parser_exec() {
    case "$1" in
        einar2*)
            log "executing $1"
            RESP=$(einar2 "${1#einar2 }")
            reply "$RESP"
            ;;
        eterm*)
            log "executing $1"
            RESP=$(eterm "${1#eterm }")
            reply "DONE"
            ;;
        dhcpcd*)
            log "executing $1"
            dhcpcd -k ; dhcpcd
            reply "DONE"
            ;;
        setxkbmap*)
            log "executing $1"
            setxkbmap "${1#setxkbmap }"
            reply "DONE"
            ;;
        shutdown)
            log "shutting down system"
            shutdown
            reply "DONE"
            ;;
        *)
            log "$1: not recognized as an einar worker runnable" "E"
            reply "FAILED"
            ;;
    esac
}

parser() {
    case "$1" in
        launch*)
            parser_launch "${1#launch }"
            ;;
        exec*)
            parser_exec "${1#exec }"
            ;;
        *)
            log "$1: not recognized as an einar worker instruction" "E"
            reply "FAILED"
            ;;
    esac
}

IFS= read -r INS
parser "$INS"
