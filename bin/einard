#!/bin/sh

set -eu
IFS='
	'

PKG_BIN_DIR=$( cd "$(dirname "$0")" ; pwd -P )
PKG_ROOT_DIR=$( cd "$PKG_BIN_DIR/.." ; pwd -P )

if [ "$(id -u)" -eq 0 ]; then
    SOCKET="/var/run/einar2.sock"
else
    SOCKET="/run/user/$(id -u)/einar2.sock"
fi

WORKER="${PKG_BIN_DIR}/ework"

if [ -S "$SOCKET" ]; then
    echo "Closing previous session"
    rm -f "$SOCKET"
fi

echo "Listening on socket $SOCKET"
socat UNIX-LISTEN:"$SOCKET",fork,reuseaddr SYSTEM:"$WORKER"
