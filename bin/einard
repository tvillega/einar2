#!/bin/bash

LOG_FILE="/var/run/einar.log"

log() {
    local ts="$(date --utc +%Y-%m-%d-%H:%M:%S)"
    printf -- "%s %s\n" "$ts" "$1" >> "$LOG_FILE"
}

launch() {
    nohup "$@" >> "/tmp/einar.log" 2>&1 &
    disown "$!" 2>/dev/null
}

response() {
    printf -- "%s" "$1"
}

parse_namespace_open() {
    local INS="$1" ; shift

    case "$INS" in
        lxterminal)
            launch lxterminal
            log "Terminal opened"
            response "OK"
            ;;
        wireshark)
            launch wireshark
            log "Wireshark opened"
            response "OK"
            ;;
        featherpad)
            launch featherpad
            log "Featherpad opened"
            response "OK"
            ;;
        *)
            log "unknown: open::$INS"
            response "FAILED"
            ;;
    esac
}

parse_namespace_eterm() {
    local INS="$1" ; shift
    local ARG="$2"

    case "$INS" in
        docker::list)
            eterm --simple einar2 run list $ARG
            response "DONE"
            ;;
        docker::start)
            eterm --simple einar2 run start $ARG
            response "DONE"
            ;;
        docker::stop)
            eterm --simple einar2 run stop $ARG
            response "DONE"
            ;;
        docker::shell)
            eterm --simple einar2 run shell $ARG
            response "DONE"
            ;;
        *)
            log "unknown: open::$INS"
            response "FAILED"
            ;;
    esac
}

parse_namespace_docker() {
    local INS="$1"
    local ARG="$2"

    case "$INS" in
        list)
            RES=$(einar2 run list $ARG)
            response "$RES"
            ;;
        start)
            RES=$(einar2 run start $ARG)
            response "$RES"
            ;;
        stop)
            RES=$(einar2 run start $ARG)
            response "$RES"
            ;;
        shell)
            eterm einar2 run shell $ARG
            response "DONE"
            ;;
        *)
            log "unknown: docker::$INS"
            response "FAILED"
            ;;
    esac
}

parse_instruction() {
    local INS="$1"

    local INS_SAN="${INS//::/$'\t'}"
    IFS=$'\t' read -r -a INS_ARRAY <<< "$INS_SAN"

    local NS="${INS_ARRAY[0]}"
    local NS_INS=("${INS_ARRAY[@]:1}")

    case "$NS" in
        open)
            parse_namespace_open "${NS_INS[@]}"
            ;;
        eterm)
            parse_namespace_eterm "${NS_INS[@]}"
            ;;
        system)
            parse_nanespace_system "${NS_INS[@]}"
            ;;
        docker)
            parse_namespace_docker "${NS_INS[@]}"
            ;;
        *)
            log "unknown namespace: $INS"
            ;;
    esac
}

IFS= read -r INS
parse_instruction "$INS"
