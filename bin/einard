#!/bin/sh

LOG_FILE="/var/run/einar.log"

log() {
    ts="$(date -u +%Y-%m-%d-%H:%M:%S)"
    printf -- "%s %s\n" "$ts" "$1" >> "$LOG_FILE"
}

launch() {
    nohup "$@" >> "/tmp/einar.log" 2>&1 &
    disown "$!" 2>/dev/null || true
}

reply() {
    printf -- "%s" "$1"
}

parse_launch() {
    INS="${1#launch }"
    case "$INS" in
        lxterminal)
            launch lxterminal
            log "Terminal opened"
            reply "DONE"
            ;;
        wireshark)
            launch wireshark
            log "Wireshark opened"
            reply "DONE"
            ;;
        featherpad)
            launch featherpad
            log "Featherpad opened"
            reply "DONE"
            ;;
        *)
            log "unknown: open::$INS"
            reply "FAILED"
            ;;
    esac
}

parse_instruction() {
    case "$1" in
        launch*)
            parse_launch "$1"
            ;;
        *)
            log "unknown instruction: $1"
            reply "FAILED"
            ;;
    esac
}

IFS= read -r INS
parse_instruction "$INS"
